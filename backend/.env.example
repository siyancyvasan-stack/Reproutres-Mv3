NODE_ENV=development
HOST=0.0.0.0
PORT=4001
# Local development uses the same direct URL for both values. In production,
# DATABASE_URL must be Supabase's transaction-mode pooler endpoint with TLS
# and a small per-function connection limit (for example, add
# pgbouncer=true&connection_limit=1). It must never be a browser VITE_ variable.
# DIRECT_DATABASE_URL must be the direct TLS endpoint used only by migrations.
DATABASE_URL=postgresql://reproutes:reproutes-local-only@localhost:5432/reproutes?schema=public
DIRECT_DATABASE_URL=postgresql://reproutes:reproutes-local-only@localhost:5432/reproutes?schema=public
# Production names. The legacy JWT_ACCESS_SECRET/JWT_ACCESS_TTL names remain
# accepted for existing installations; never expose either value to clients.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=reproutes-api
JWT_AUDIENCE=reproutes-clients
CORS_ORIGINS=http://localhost:4002
# Number of controlled reverse-proxy hops in front of Express.
TRUST_PROXY_HOPS=1
# Optional. Leave empty to use in-process rate limiting and disable presence
# distribution; an outage degrades safely without stopping the API.
REDIS_URL=
REDIS_KEY_PREFIX=reproutes:
REDIS_CONNECT_TIMEOUT_MS=5000
SHUTDOWN_GRACE_MS=30000
SOCKET_PRESENCE_TTL_SECONDS=60
# Production requests must arrive over TLS (directly or through the trusted proxy).
ENFORCE_HTTPS=false
HSTS_MAX_AGE_SECONDS=31536000
COOKIE_DOMAIN=
# Prefer lax when the web app and API are same-site. Use none only for HTTPS cross-site deployments.
COOKIE_SAME_SITE=lax
# Optional as a group. In production, configure all four for permanent object
# storage. The bucket may be private; keep the secret key server-side.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# Legacy deployments may use SUPABASE_SERVICE_ROLE_KEY instead of
# SUPABASE_SECRET_KEY. Configure only one; both are server-only.
SUPABASE_STORAGE_BUCKET=sales-images
LOG_LEVEL=info
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Reproutes <no-reply@reproutes.local>
OTP_TTL_MINUTES=10
# WebAuthn permits HTTP only for localhost development. Production must use HTTPS.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:4002
WEBAUTHN_RP_NAME=Reproutes
# Optional server-side key for contextual Operations AI. Never expose this as a VITE_ variable.
GOOGLE_GENAI_API_KEY=
GPS_HISTORY_RETENTION_DAYS=90
# Optional server-side SMS gateway adapter. It receives POST JSON containing
# { to, message, eventId } and an Authorization: Bearer <token> header.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
