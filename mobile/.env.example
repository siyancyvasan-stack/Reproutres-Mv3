# Required. Set this in the ignored mobile/.env file to an API origin reachable
# from the selected device. Android emulator example: http://10.0.2.2:4001.
# Physical devices require the development machine's current LAN origin.
# Staging and production values are supplied by their EAS environments and must use HTTPS.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_TENANT_SLUG=reproutes-demo
EXPO_PUBLIC_EAS_PROJECT_ID=
